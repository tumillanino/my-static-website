# By default, builds read this manifest:
# https://blogs.anthonytumia.com/blog/posts.json
#
# Example posts.json:
# {
#   "posts": [
#     "stepping-away-from-social-media.md",
#     "another-post.md"
#   ]
# }

# Optional override if you want to bypass posts.json:
# BLOG_POST_URLS=https://blogs.anthonytumia.com/blog/stepping-away-from-social-media.md

# Optional: make production builds fail if a configured remote post cannot be fetched.
# BLOG_SYNC_STRICT=1
